%% Generated by mdbrand — do not edit here; edit the brand bundle or the template.
%% brand: {{.Brand.Name}}   style: {{.Style}}
\usepackage{etoolbox}

{{template "colors" .}}
{{- if .Brand.Slides.Dark}}
\definecolor{brandGround}{HTML}{ {{- .Brand.Slides.Background -}} }
\definecolor{brandOnGround}{HTML}{ {{- .Brand.Slides.Foreground -}} }
{{- end}}

{{if .DisplayFont -}}
% Ligatures=TeX, which the page preamble does without: there every display
% string is mdbrand's own and keeps its Unicode, while here frame titles come
% from pandoc, which writes an em dash as --- and a face without the ligature
% prints three hyphens.
\newfontfamily\brandDisplay{ {{- .DisplayRegular -}} }[Path={{.DisplayRegularDir}},RawFeature=-calt,Ligatures=TeX]
\newfontfamily\brandDisplayBold{ {{- .DisplayBold -}} }[Path={{.DisplayBoldDir}},RawFeature=-calt,Ligatures=TeX]
{{- else -}}
\newcommand{\brandDisplay}{\mdseries}
\newcommand{\brandDisplayBold}{\bfseries}
{{- end}}

{{template "fallback" . -}}
{{if .LogoFile -}}
\newcommand{\brandLogo}[1]{\includegraphics[width=#1]{ {{- .LogoFile -}} }}
{{- else -}}
\newcommand{\brandLogo}[1]{\brandDisplayBold{}{{texEscape .Brand.DisplayName}}}
{{- end}}
{{if .SlideLogoFile -}}
\newcommand{\brandSlideLogo}[1]{\includegraphics[width=#1]{ {{- .SlideLogoFile -}} }}
{{- else -}}
\newcommand{\brandSlideLogo}[1]{\brandLogo{#1}}
{{- end}}

% ------------------------------------------------------------------ frames ---
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left={{.SlideMarginMM}}mm,text margin right={{.SlideMarginMM}}mm}
\setbeamercolor{normal text}{fg=brandText}
\setbeamercolor{structure}{fg=brandPrimary}
\setbeamercolor{frametitle}{fg=brandText}
\setbeamerfont{frametitle}{size=\Large}
\setbeamertemplate{itemize item}{\color{brandPrimary}\raisebox{0.15ex}{\tiny$\blacksquare$}}
\setbeamertemplate{itemize subitem}{\color{brandPrimary}\raisebox{0.15ex}{\tiny$\square$}}
\setbeamertemplate{itemize subsubitem}{\color{brandPrimary}--}
% A caption on a slide is a label, not a cross-reference: no "Figure 3:".
% Through the caption package, which pandoc loads for any document with a
% table and which then overrides beamer's own caption template: a deck with a
% table numbered its figures and one without did not.
\usepackage{caption}
\captionsetup{labelformat=empty,labelsep=none,font={scriptsize,color=brandText},skip=4pt}

\setbeamertemplate{frametitle}{%
  \vskip4mm\begingroup\brandDisplayBold\insertframetitle\endgroup\par\vskip1.2mm
  \begingroup\color{brandPrimary}\rule{12mm}{0.8pt}\endgroup\par\vskip1mm}

{{- if .Confidential}}
\newcommand{\brandConfidential}{\begingroup\color{brandPrimary}{{texEscape .Confidential}}\endgroup\quad}
{{- else}}
\newcommand{\brandConfidential}{}
{{- end}}
\newcommand{\brandRunningTitle}{ {{- texEscape .HeaderTitle -}} }

% The title and section slides are covers: no footer, and the bundle's ground
% when it declares one. beamer draws the background and the footer when the
% page is shipped out, after the frame's body has run, so the cover templates
% mark their page by number and the two templates below look the mark up.
\newcommand{\mdbrandMarkCover}{\expandafter\gdef\csname mdbrandCover\the\value{page}\endcsname{}}
\newcommand{\mdbrandIfCover}[2]{\ifcsname mdbrandCover\the\value{page}\endcsname #1\else #2\fi}

\setbeamertemplate{footline}{\mdbrandIfCover{}{%
  \hbox to\paperwidth{\hskip{{.SlideMarginMM}}mm\begingroup\color{brandRule}\rule{\dimexpr\paperwidth-{{.SlideMarginMM}}mm*2\relax}{0.3pt}\endgroup\hss}%
  \vskip1.2mm
  \hbox to\paperwidth{\hskip{{.SlideMarginMM}}mm\raisebox{-0.2mm}{\brandLogo{ {{- .Brand.Slides.LogoWidth -}} }}\hfill
    \begingroup\brandDisplay\fontsize{7}{8}\selectfont\color{brandText}\brandConfidential\brandRunningTitle\quad\insertframenumber\endgroup
    \hskip{{.SlideMarginMM}}mm}%
  \vskip3mm}}

{{if .Brand.Slides.Dark -}}
\setbeamertemplate{background canvas}{\mdbrandIfCover{%
  \vbox to\paperheight{\hbox to\paperwidth{%
    \rlap{\color{brandGround}\rule{\paperwidth}{\paperheight}}\hfill
    {{- if .SlideArtFile}}\includegraphics[height=\paperheight]{ {{- .SlideArtFile -}} }{{end -}}
  }\vss}}{}}
\newcommand{\mdbrandCoverText}{brandOnGround}
\newcommand{\mdbrandCoverAccent}{brandPrimary}
{{- else -}}
{{if .SlideArtFile -}}
\setbeamertemplate{background canvas}{\mdbrandIfCover{%
  \vbox to\paperheight{\hbox to\paperwidth{\hfill\includegraphics[height=\paperheight]{ {{- .SlideArtFile -}} }}\vss}}{}}
{{- end}}
\newcommand{\mdbrandCoverText}{brandText}
\newcommand{\mdbrandCoverAccent}{brandPrimary}
{{- end}}

% Strings are escaped by mdbrand, as on the page: pandoc's \title is only what
% makes it write \frame{\titlepage}.
\setbeamertemplate{title page}{\mdbrandMarkCover
  \begingroup\raggedright\color{\mdbrandCoverText}%
  \vskip2mm\brandSlideLogo{ {{- .Brand.Slides.LogoWidthCover -}} }\par
  \vfill
  \begingroup\color{\mdbrandCoverAccent}\rule{20mm}{1.2pt}\endgroup\par\vskip5mm
  \begingroup\brandDisplayBold\fontsize{24}{28}\selectfont {{texEscape .Title}}\par\endgroup
{{- if .Subtitle}}
  \vskip3mm\begingroup\brandDisplay\fontsize{13}{17}\selectfont {{texEscape .Subtitle}}\par\endgroup
{{- end}}
  \vfill
  \begingroup\brandDisplay\fontsize{9}{12}\selectfont
{{if .Author}}{{texEscape .Author}}{{end}}{{if and .Author .Date}}\quad\textperiodcentered\quad{}{{end}}{{if .Date}}{{texEscape .Date}}{{end}}
{{- if .Reference}}\par\vskip1mm {{texEscape .Reference}}{{end}}
{{- if .Confidential}}\par\vskip1mm\begingroup\color{\mdbrandCoverAccent}{{texEscape .Confidential}}\endgroup{{end}}
{{- if .Brand.Footer}}\par\vskip1mm {{texEscape .Brand.Footer}}{{end}}\par\endgroup
  \vskip4mm
  \endgroup}

% The section's name is a link, and colorlinks would paint it in the link
% colour: linkcolor=. is xcolor's current colour, the cover's own.
\setbeamertemplate{section page}{\mdbrandMarkCover
  \begingroup\raggedright\hypersetup{linkcolor=.}%
  \vfill
  \begingroup\color{\mdbrandCoverAccent}\rule{20mm}{1.2pt}\endgroup\par\vskip5mm
  \begingroup\brandDisplayBold\fontsize{22}{26}\selectfont\color{\mdbrandCoverText}\insertsectionhead\par\endgroup
  \vfill
  \endgroup}

{{template "code" .}}
