%% Generated by mdbrand — front page for style "{{.Style}}".
{{if eq .Style "report" -}}
\thispagestyle{empty}
\begingroup
\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}\raggedright
{{if .LogoSecondaryFile -}}
% Two identities: one at each end of the measure, on a shared baseline, the way
% a letterhead sets them. \includegraphics boxes already rest on the baseline,
% so no \raisebox belongs here.
\noindent\brandLogo{ {{- .CoverLogoWidth -}} }\hfill\brandLogoSecondary{ {{- .CoverLogoSecondaryWidth -}} }\par
{{- else -}}
\brandLogo{ {{- .CoverLogoWidth -}} }\par
{{- end}}
\vfill
{\color{brandPrimary}\rule{\textwidth}{1.6pt}}\par
\vspace{9mm}
{\brandDisplayBold\fontsize{27}{32}\selectfont\color{brandText}{{texEscape .Title}}\par}
{{if .Subtitle -}}
\vspace{6mm}
{\brandDisplay\fontsize{13}{18}\selectfont\color{brandText}{{texEscape .Subtitle}}\par}
{{- end}}
{{if .Reference -}}
\vspace{5mm}
{\brandDisplay\fontsize{10}{14}\selectfont\color{brandText}{{texEscape .Reference}}\par}
{{- end}}
\vfill
{\color{brandRule}\rule{\textwidth}{0.4pt}}\par
\vspace{3.5mm}
{\brandDisplay\fontsize{9.5}{13}\selectfont\color{brandText}
{{- if .Author}}{{texEscape .Author}}\par\vspace{1.2mm}{{end}}
{{- if .Date}}{{texEscape .Date}}\par{{end}}
{{- if .Confidential}}\vspace{2.5mm}{\color{brandPrimary}{{texEscape .Confidential}}}\par{{end}}
{{- if .Brand.Footer}}\vspace{2.5mm}{{texEscape .Brand.Footer}}\par{{end}}}
\endgroup
\clearpage
\setcounter{page}{1}
{{- else if eq .Style "note" -}}
% A note has no cover: it opens with its own title block and carries the header
% from the first page, because it is read at a desk and not handed over.
\begingroup
\setlength{\parindent}{0pt}\raggedright
{\brandDisplayBold\fontsize{19}{23}\selectfont\color{brandText}{{texEscape .Title}}\par}
{{if .Subtitle -}}
\vspace{2.5mm}
{\brandDisplay\fontsize{11}{15}\selectfont\color{brandText}{{texEscape .Subtitle}}\par}
{{- end}}
\vspace{3mm}
{\color{brandPrimary}\rule{\textwidth}{1pt}}\par
\vspace{2mm}
{\brandDisplay\fontsize{9}{12}\selectfont\color{brandText}
{{- if .Author}}{{texEscape .Author}}{{end}}{{if and .Author .Date}} \textperiodcentered{} {{end}}{{if .Date}}{{texEscape .Date}}{{end}}
{{- if .Confidential}} \textperiodcentered{} {\color{brandPrimary}{{texEscape .Confidential}}}{{end}}\par}
\endgroup
\vspace{7mm}
{{- else if eq .Style "letter" -}}
% Letterhead. The signature block is appended after the body.
\thispagestyle{empty}
\begingroup
\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}\raggedright
\brandLogo{ {{- .CoverLogoWidth -}} }\par
\vspace{14mm}
{{if .Recipient -}}
{\brandDisplay\fontsize{10}{14}\selectfont\color{brandText}%
{{range .Recipient}}{{texEscape .}}\par
{{end}}}
\vspace{10mm}
{{- end}}
{\brandDisplay\fontsize{10}{14}\selectfont\color{brandText}
{{- if .Place}}{{texEscape .Place}}{{if .Date}}, {{end}}{{end}}{{if .Date}}{{texEscape .Date}}{{end}}\par}
\vspace{10mm}
{{if .Title -}}
{\brandDisplayBold\fontsize{12}{16}\selectfont\color{brandText}{{texEscape .Title}}\par}
\vspace{6mm}
{{- end}}
{{if .Greeting -}}
{{texEscape .Greeting}}\par
\vspace{3mm}
{{- end}}
\endgroup
{{- end}}
