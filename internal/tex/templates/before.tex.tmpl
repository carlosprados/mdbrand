{{/* The report's cover in three parts, so that a cover picture can measure
     them before taking the height they leave. Without a picture they are set
     one after the other, as they always were. */ -}}
{{define "coverHead"}}{{if .LogoSecondaryFile -}}
% Two identities: one at each end of the measure, on a shared baseline, the way
% a letterhead sets them. \includegraphics boxes already rest on the baseline,
% so no \raisebox belongs here.
\noindent\brandLogo{ {{- .CoverLogoWidth -}} }\hfill\brandLogoSecondary{ {{- .CoverLogoSecondaryWidth -}} }\par
{{- else -}}
\brandLogo{ {{- .CoverLogoWidth -}} }\par
{{- end}}{{end -}}
{{define "coverTitle"}}{\color{brandPrimary}\rule{\textwidth}{1.6pt}}\par
\vspace{9mm}
{\brandDisplayBold\fontsize{27}{32}\selectfont\color{brandText}{{.Esc .Title}}\par}
{{if .Subtitle -}}
\vspace{6mm}
{\brandDisplay\fontsize{13}{18}\selectfont\color{brandText}{{.Esc .Subtitle}}\par}
{{- end}}
{{if .Reference -}}
\vspace{5mm}
{\brandDisplay\fontsize{10}{14}\selectfont\color{brandText}{{texEscape .Reference}}\par}
{{- end}}{{end -}}
{{define "coverFoot"}}{\color{brandRule}\rule{\textwidth}{0.4pt}}\par
\vspace{3.5mm}
{\brandDisplay\fontsize{9.5}{13}\selectfont\color{brandText}
{{- if .Author}}{{.Esc .Author}}\par\vspace{1.2mm}{{end}}
{{- if .Date}}{{.Esc .Date}}\par{{end}}
{{- if .Confidential}}\vspace{2.5mm}{\color{brandPrimary}{{texEscape .Confidential}}}\par{{end}}
{{- if .Brand.Footer}}\vspace{2.5mm}{{texEscape .Brand.Footer}}\par{{end}}}{{end -}}
{{define "coverPicture"}}% The picture takes the height the logo, the title block and the foot leave,
% measured here because only TeX knows how many lines the title wraps to.
% Under 45mm the cover would be a thumbnail: the log says so and the build
% stops. Over 62% of the text height it would crowd the title against it.
% The credit is in the body face: it names a work, in italics, and a display
% face often has none.
\newsavebox{\mdbrandCoverHead}\newsavebox{\mdbrandCoverTitle}
\newsavebox{\mdbrandCoverFoot}\newsavebox{\mdbrandCoverCredit}
\newlength{\mdbrandCoverRoom}
\setbox\mdbrandCoverHead=\vbox\bgroup\hsize=\textwidth
{{template "coverHead" .}}
\egroup
\setbox\mdbrandCoverTitle=\vbox\bgroup\hsize=\textwidth
{{template "coverTitle" .}}
\egroup
\setbox\mdbrandCoverFoot=\vbox\bgroup\hsize=\textwidth
{{template "coverFoot" .}}
\egroup
\setbox\mdbrandCoverCredit=\vbox\bgroup\hsize=\textwidth
{{- if .CoverCredit}}
\vspace{2mm}
{\fontsize{7.5}{9.5}\selectfont\color{brandText}{{.Esc .CoverCredit}}\par}
{{- end}}
\egroup
% The gaps below are 34mm; TeX puts \topskip above the first box of the page,
% and 2mm more absorbs what the rest rounds to. Without that the foot, set
% last, was pushed alone onto a page of its own.
\setlength{\mdbrandCoverRoom}{\dimexpr\textheight-\topskip-36mm
  -\ht\mdbrandCoverHead-\dp\mdbrandCoverHead-\ht\mdbrandCoverTitle-\dp\mdbrandCoverTitle
  -\ht\mdbrandCoverFoot-\dp\mdbrandCoverFoot-\ht\mdbrandCoverCredit-\dp\mdbrandCoverCredit\relax}
\ifdim\mdbrandCoverRoom>0.62\textheight\setlength{\mdbrandCoverRoom}{0.62\textheight}\fi
\ifdim\mdbrandCoverRoom<45mm\typeout{MDBRAND-COVER-TOOSMALL room=\the\mdbrandCoverRoom}\fi
% The title and the foot sit at the bottom, and the picture is centred in what
% is left above them: shared out around the title, the room a wide picture
% left over raised the title, and a series of covers set it at a different
% height on each.
\nointerlineskip\box\mdbrandCoverHead
\vspace{10mm plus 1fill}
\nointerlineskip\hbox{\includegraphics[width=\textwidth,height=\mdbrandCoverRoom,keepaspectratio]{ {{- .CoverImageFile -}} }}
\nointerlineskip\box\mdbrandCoverCredit
\vspace{12mm plus 1fill}
\nointerlineskip\box\mdbrandCoverTitle
\vspace{12mm}
\nointerlineskip\box\mdbrandCoverFoot{{end -}}
%% Generated by mdbrand — front page for style "{{.Style}}".
{{if eq .Style "report" -}}
\thispagestyle{empty}
\begingroup
\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}\raggedright
{{if .CoverImageFile -}}
{{template "coverPicture" .}}
{{- else -}}
{{template "coverHead" .}}
\vfill
{{template "coverTitle" .}}
\vfill
{{template "coverFoot" .}}
{{- end}}
\endgroup
\clearpage
\setcounter{page}{1}
{{- else if eq .Style "thesis" -}}
{{with .Thesis -}}
% The UPM's three fixed pages: cubierta, portada and créditos, each with "the
% data in the < > slots and no other information". The escudos are set at the
% template's sizes, not the bundle's logo widths. Créditos is page i.
\frontmatter
\thispagestyle{empty}
\begin{center}
{\large\MakeUppercase{ {{- texEscape .University -}} }}\par
\vspace{4mm}
{{texEscape .Centre}}\par
\vspace{14mm}
\brandLogo{50.8mm}\par
\vfill
{\Large\bfseries {{$.Esc $.Title}}\par}
\vspace{10mm}
{\bfseries {{if .EN}}DOCTORAL THESIS{{else}}TESIS DOCTORAL{{end}}}\par
\vspace{10mm}
{{if .EN}}Submitted for the degree of Doctor by:{{else}}Presentada para optar al título de Doctor por:{{end}}\par
\vspace{4mm}
{\bfseries {{$.Esc $.Author}}}\par
\vspace{2mm}
{{texEscape .Degree}}\par
\vfill
Madrid, {{.Year}}\par
\end{center}
\clearpage
\thispagestyle{empty}
\noindent\begin{minipage}[c]{0.22\textwidth}\centering\brandLogoSecondary{32.6mm}\end{minipage}%
\begin{minipage}[c]{0.22\textwidth}\centering\brandLogo{32.6mm}\end{minipage}\hfill
\begin{minipage}[c]{0.52\textwidth}\raggedright\MakeUppercase{ {{- texEscape .University -}} }\par\vspace{2mm}{{texEscape .Centre}}\end{minipage}
\begin{center}
\vspace{18mm}
{\bfseries {{if .EN}}Doctoral Programme in{{else}}Doctorado en{{end}} {{texEscape .Programme}}}\par
\vfill
{\Large\bfseries {{$.Esc $.Title}}\par}
\vspace{10mm}
{\bfseries {{if .EN}}DOCTORAL THESIS{{else}}TESIS DOCTORAL{{end}}}\par
\vspace{8mm}
{{if .EN}}Submitted for the degree of Doctor by:{{else}}Presentada para optar al título de Doctor por:{{end}}\par
\vspace{3mm}
{\bfseries {{$.Esc $.Author}}}\par
{{texEscape .Degree}}\par
\vspace{8mm}
{{if .EN}}Supervised by:{{else}}Bajo la dirección de:{{end}}\par
\vspace{3mm}
{{range .Directors}}{{texEscape .Name}}\par
{{end -}}
\vfill
Madrid, {{.Year}}\par
\end{center}
\clearpage
\setcounter{page}{1}
\begingroup
\setlength{\parindent}{0pt}\setlength{\parskip}{3mm}
{{if .EN}}Title{{else}}Título{{end}}: {{$.Esc $.Title}}\par
{{if .EN}}Author{{else}}Autor{{end}}: {{$.Esc $.Author}}\par
{{if .EN}}Doctoral Programme{{else}}Programa de Doctorado{{end}}: {{texEscape .Programme}}\par
{{if .EN}}Supervision{{else}}Dirección de tesis{{end}}:\par\vspace{-2mm}
{{range .Directors}}{{texEscape .Name}}, {{texEscape .Position}}, {{texEscape .Institution}} ({{if $.Thesis.EN}}{{if .Co}}Co-supervisor{{else}}Supervisor{{end}}{{else}}{{if .Co}}Codirector{{else}}Director{{end}}{{end}})\par
{{end -}}
{{if .EN}}External reviewers{{else}}Revisores externos{{end}}:\par
{{if .EN}}Thesis committee{{else}}Tribunal de tesis{{end}}:\par
{{if .EN}}Date of defence{{else}}Fecha de defensa{{end}}:\par
\vfill
{{if .Funding}}{{if .EN}}This thesis has been partially funded by{{else}}Esta tesis ha sido parcialmente financiada por{{end}} {{texEscape .Funding}}.\par
{{end -}}
\endgroup
\clearpage
{{- end}}
{{- else if eq .Style "note" -}}
% A note has no cover: it opens with its own title block and carries the header
% from the first page, because it is read at a desk and not handed over.
\begingroup
\setlength{\parindent}{0pt}\raggedright
{\brandDisplayBold\fontsize{19}{23}\selectfont\color{brandText}{{.Esc .Title}}\par}
{{if .Subtitle -}}
\vspace{2.5mm}
{\brandDisplay\fontsize{11}{15}\selectfont\color{brandText}{{.Esc .Subtitle}}\par}
{{- end}}
\vspace{3mm}
{\color{brandPrimary}\rule{\textwidth}{1pt}}\par
\vspace{2mm}
{\brandDisplay\fontsize{9}{12}\selectfont\color{brandText}
{{- if .Author}}{{.Esc .Author}}{{end}}{{if and .Author .Date}} \textperiodcentered{} {{end}}{{if .Date}}{{.Esc .Date}}{{end}}
{{- if .Confidential}}{{if or .Author .Date}} \textperiodcentered{} {{end}}{\color{brandPrimary}{{texEscape .Confidential}}}{{end}}\par}
\endgroup
\vspace{7mm}
{{- else if eq .Style "letter" -}}
% Letterhead. The signature block is appended after the body.
\thispagestyle{empty}
\begingroup
\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}\raggedright
\brandLogo{ {{- .CoverLogoWidth -}} }\par
\vspace{14mm}
{{if .Recipient -}}
{\brandDisplay\fontsize{10}{14}\selectfont\color{brandText}%
{{range .Recipient}}{{texEscape .}}\par
{{end}}}
\vspace{10mm}
{{- end}}
{\brandDisplay\fontsize{10}{14}\selectfont\color{brandText}
{{- if .Place}}{{texEscape .Place}}{{if .Date}}, {{end}}{{end}}{{if .Date}}{{.Esc .Date}}{{end}}\par}
% The letterhead page has no footer, so a one-page letter would carry the label
% nowhere: it goes under the date.
{{if .Confidential -}}
\vspace{1.5mm}{\brandDisplay\fontsize{10}{14}\selectfont\color{brandPrimary}{{texEscape .Confidential}}\par}
{{- end}}
\vspace{10mm}
{{if .Title -}}
{\brandDisplayBold\fontsize{12}{16}\selectfont\color{brandText}{{.Esc .Title}}\par}
\vspace{6mm}
{{- end}}
{{if .Greeting -}}
{{texEscape .Greeting}}\par
\vspace{3mm}
{{- end}}
\endgroup
{{- end}}
