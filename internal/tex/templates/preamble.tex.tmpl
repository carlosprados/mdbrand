%% Generated by mdbrand — do not edit here; edit the brand bundle or the template.
%% brand: {{.Brand.Name}}   style: {{.Style}}
\usepackage{graphicx}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage{etoolbox}
\usepackage{fontspec}
\usepackage{microtype}

{{template "colors" .}}
% With colorlinks on, hyperref paints a footnote mark in the link colour too,
% and a bare coloured "1" reads as an accent. The note is at the foot of the
% same page, so the jump is worth less than the mark looking like text.
% Passed here because pandoc loads hyperref after this preamble.
\PassOptionsToPackage{hyperfootnotes=false}{hyperref}

% Tables: a full-size table in a 10pt document overflows the measure, and the
% overflow is silent. footnotesize plus a little air is the shape that works.
\AtBeginEnvironment{longtable}{\footnotesize}
\renewcommand{\arraystretch}{1.25}

{{if .DisplayFont -}}
% Display font referenced by path: a commercially licensed face is never copied
% into a bundle, so a machine without it falls back instead of failing.
% One Path per face: the two weights need not live in the same directory, and
% assuming they do is a build that dies inside fontspec after validate said ok.
% RawFeature=-calt for the reason the body face has it: contextual alternates
% can be glyphs the PDF's text layer maps to private-use code points.
\newfontfamily\brandDisplay{ {{- .DisplayRegular -}} }[Path={{.DisplayRegularDir}},RawFeature=-calt]
\newfontfamily\brandDisplayBold{ {{- .DisplayBold -}} }[Path={{.DisplayBoldDir}},RawFeature=-calt]
{{- else -}}
\newcommand{\brandDisplay}{\mdseries}
\newcommand{\brandDisplayBold}{\bfseries}
{{- end}}

{{template "fallback" . -}}
% pandoc calls \maketitle when the document has a title. The front page is
% built by mdbrand as an include-before-body instead, with the strings already
% escaped, so no \@title catcode games and no intercepting \subtitle.
\renewcommand{\maketitle}{}

{{if .LogoFile -}}
\newcommand{\brandLogo}[1]{\includegraphics[width=#1]{ {{- .LogoFile -}} }}
{{- else -}}
\newcommand{\brandLogo}[1]{\brandDisplayBold\color{brandText}{{texEscape .Brand.DisplayName}}}
{{- end}}

% The cover's second mark. Defined even when the bundle declares none, so the
% cover template can call it unconditionally and get nothing.
{{if .LogoSecondaryFile -}}
\newcommand{\brandLogoSecondary}[1]{\includegraphics[width=#1]{ {{- .LogoSecondaryFile -}} }}
{{- else -}}
\newcommand{\brandLogoSecondary}[1]{}
{{- end}}

% ------------------------------------------------------------------ header ---
\newcommand{\brandRunningTitle}{ {{- texEscape .HeaderTitle -}} }
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\brandDisplay\fontsize{8.5}{10}\selectfont\color{brandText}\brandRunningTitle}
\fancyhead[R]{\brandLogo{ {{- .HeaderLogoWidth -}} }}
\fancyfoot[C]{\brandDisplay\fontsize{8.5}{10}\selectfont\color{brandText}\thepage}
{{- if .Confidential}}
% The cover's confidentiality label, repeated on every page left of the number.
% fancyhdr sets the two boxes independently and lets them overprint in silence,
% so the label is measured once the fonts are loaded, against the left half of
% the measure less a three-digit page number and a gap; mdbrand stops the build
% on the marker.
\newcommand{\brandConfidential}{\brandDisplay\fontsize{8.5}{10}\selectfont\color{brandPrimary}{{texEscape .Confidential}}}
\fancyfoot[L]{\brandConfidential}
\newsavebox\mdbrandConfBox
\newsavebox\mdbrandPageBox
\AtBeginDocument{%
  \sbox\mdbrandConfBox{\brandConfidential}%
  \sbox\mdbrandPageBox{\brandDisplay\fontsize{8.5}{10}\selectfont 999}%
  \ifdim\dimexpr\wd\mdbrandConfBox+0.5\wd\mdbrandPageBox+4mm\relax>0.5\textwidth
    \typeout{MDBRAND-CONFIDENTIAL-TOOWIDE over=\the\dimexpr\wd\mdbrandConfBox+0.5\wd\mdbrandPageBox+4mm-0.5\textwidth\relax}%
  \fi
}
{{- end}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
% \begingroup instead of a nested brace group on purpose: a doubled opening
% brace anywhere in this file, comments included, starts a template action.
\renewcommand{\headrule}{\begingroup\color{brandRule}\hrule height\headrulewidth width\headwidth\endgroup}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\brandDisplay\fontsize{8.5}{10}\selectfont\color{brandText}\brandRunningTitle}%
  \fancyhead[R]{\brandLogo{ {{- .HeaderLogoWidth -}} }}%
  \fancyfoot[C]{\brandDisplay\fontsize{8.5}{10}\selectfont\color{brandText}\thepage}%
{{- if .Confidential}}
  \fancyfoot[L]{\brandConfidential}%
{{- end}}
  \renewcommand{\headrulewidth}{0.4pt}%
}
% The running title gets the whole \headwidth from fancyhdr and runs under the
% logo, or wraps to a second line, without a word in the log. Measured in one
% line against the logo's real box (an image, or the brand's name set as text)
% plus 2mm; mdbrand stops the build on the marker and names short_title. 4mm
% refused a title that read cleanly 2.3mm from the mark.
\newsavebox\mdbrandHeadTitleBox
\newsavebox\mdbrandHeadLogoBox
\AtBeginDocument{%
  \sbox\mdbrandHeadTitleBox{\brandDisplay\fontsize{8.5}{10}\selectfont\brandRunningTitle}%
  \sbox\mdbrandHeadLogoBox{\brandLogo{ {{- .HeaderLogoWidth -}} }}%
  \ifdim\dimexpr\wd\mdbrandHeadTitleBox+\wd\mdbrandHeadLogoBox+2mm\relax>\textwidth
    \typeout{MDBRAND-TITLE-TOOWIDE over=\the\dimexpr\wd\mdbrandHeadTitleBox+\wd\mdbrandHeadLogoBox+2mm-\textwidth\relax}%
  \fi
}

% Figures placed by mdbrand are already sized in millimetres; centre them and
% keep the caption small and grey.
\usepackage{caption}
\captionsetup{font={small,color=brandText},labelfont={bf},skip=6pt}

% babel's Spanish labels a table "Cuadro", the humanities' usage; technical and
% business Spanish says "Tabla", which is what babel's own es-tabla option does.
% That option cannot be passed: pandoc has loaded babel before this preamble.
% The caption hook runs again at \begin{document}, so appending to it works.
\ifdefined\captionsspanish
  \addto\captionsspanish{\renewcommand{\tablename}{Tabla}\renewcommand{\listtablename}{Índice de tablas}}%
\fi

